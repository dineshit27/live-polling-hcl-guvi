# ==============================================================================
# LIVE POLLING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local Docker Compose or export these variables in
# your production container/PaaS orchestration environment (Kubernetes, AWS, etc).
#
# DO NOT COMMIT THE ACTUAL .env FILE OR ANY PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Gin operational mode: "debug" (local development/verbose logging) or "release" (production)
# Local default: debug | Production: release
GIN_MODE=release

# Port for the Go/Gin HTTP server inside its execution container.
# Local default: 8080 | Production: 8080 (or $PORT provided by platform)
PORT=8080

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (HMAC-SHA256).
# In production, this MUST be an unpredictable, high-entropy secret (e.g. openssl rand -hex 32).
# NEVER expose this key to the frontend or bake into client bundles.
# Local default: dev_secret_key_change_in_production_12345
JWT_SECRET=your_production_jwt_secret_min_32_characters_long

# ------------------------------------------------------------------------------
# 3. DATABASE (MONGODB) CONFIGURATION
# ------------------------------------------------------------------------------
# MongoDB connection URI (supports standalone, replica sets, and MongoDB Atlas SRV).
# Local Docker Compose: mongodb://mongodb:27017/polling_db
# Local host:           mongodb://127.0.0.1:27017
# Production Atlas:     mongodb+srv://<username>:<password>@cluster.mongodb.net/polling_db?retryWrites=true&w=majority
MONGO_URI=mongodb://mongodb:27017/polling_db

# MongoDB database name where collections ('users', 'polls', 'votes') reside.
MONGO_DB_NAME=polling_db

# ------------------------------------------------------------------------------
# 4. REALTIME EVENT BUS (REDIS PUB/SUB) CONFIGURATION
# ------------------------------------------------------------------------------
# Redis network host and port.
# Local Docker Compose: redis:6379
# Local host:           127.0.0.1:6379
# Production:           redis-cluster.internal:6379 or cloud Redis endpoint
REDIS_ADDR=redis:6379

# Redis authentication password (leave empty if no authentication is enabled on Redis).
# Local: (empty) | Production: your_redis_auth_password
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# In production, specify your exact HTTPS domain(s).
# DO NOT use wildcard '*' in production when credentials/authorization are sent.
# Local default: http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
# Production:    https://polls.yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 6. FRONTEND (VITE / CLIENT) STRATEGY
# ------------------------------------------------------------------------------
# NOTE: The frontend application uses relative API paths ('/api/*') routed via
# Nginx or the local dev reverse-proxy. NO secret credentials should ever be
# prefixed with VITE_* or placed in frontend bundles.
# Optional build-time override for standalone decoupled client hosting only:
VITE_API_URL=
